# --- Backend API (separate C# / Azure Functions isolated-worker project) ---
# Browser-facing API base path. Same-origin relative path proxied to the backend
# by the Vite dev server (see server.proxy in vite.config.ts) to avoid CORS in dev.
VITE_API_BASE_URL=/api

# Dev-server proxy target (server-side only, NOT exposed to the client bundle).
# Origin of the Hiscox.RiskModeller.Api Azure Functions backend.
API_PROXY_TARGET=http://localhost:7192

# --- Module Federation ---
# URL of THIS remote's published remoteEntry.js. The Rehub host references this
# value via its own env var (VITE_RISK_MODELLER_REMOTE_URL) to load the remote.
VITE_RISK_MODELLER_REMOTE_URL=http://localhost:3030/assets/remoteEntry.js
