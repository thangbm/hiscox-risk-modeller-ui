# Local development environment.

# Browser-facing API base path. SAME-ORIGIN relative path: requests go to the
# Vite dev server (port 3030), which proxies /api to the backend server-to-server
# (see vite.config.ts). This avoids CORS in local dev.
VITE_API_BASE_URL=/api

# Dev-server proxy target (server-side only, NOT bundled into the client).
# Origin of the locally-running Azure Functions backend (default func port 7192).
API_PROXY_TARGET=http://localhost:7192

VITE_RISK_MODELLER_REMOTE_URL=http://localhost:3030/assets/remoteEntry.js
