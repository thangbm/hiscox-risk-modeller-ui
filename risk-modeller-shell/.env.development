# Remote URLs
# vite-plugin-federation only outputs remoteEntry.js via `vite build`, not `vite serve`.
# To develop the shell, first build+preview the remote:
#   cd ../risk-modeller-ui && npm run build && npm run preview
# Then start the shell:
#   cd ../risk-modeller-shell && npm run dev
VITE_RISK_MODELLER_REMOTE_URL=http://localhost:3030/assets/remoteEntry.js

# Dev-server proxy target (server-side only, NOT bundled into the client).
# Origin of the Hiscox.RiskModeller.Api Azure Functions backend.
API_PROXY_TARGET=http://localhost:7192

# Azure AD (Entra ID) — MSAL configuration.
# PLACEHOLDERS: fill in with the real Entra ID App Registration values.
# Prerequisites (manual, Azure Portal):
#   - Register a SPA redirect URI matching VITE_AZURE_AD_REDIRECT_URI below.
#   - Define an App Role (e.g. "RiskModeller.Read") and assign it to the
#     relevant users/groups; set its exact name in VITE_AZURE_AD_REQUIRED_ROLE.
# While VITE_AZURE_AD_CLIENT_ID / VITE_AZURE_AD_TENANT_ID are blank, the app
# automatically falls back to `src/auth/fakeMsalInstance.ts` — a fake,
# already-signed-in dev account (holding VITE_AZURE_AD_REQUIRED_ROLE) so the
# shell and Risk Modeller route work end-to-end without real AAD.
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_REDIRECT_URI=http://localhost:4000
VITE_AZURE_AD_POST_LOGOUT_REDIRECT_URI=http://localhost:4000
VITE_AZURE_AD_REQUIRED_ROLE=RiskModeller.Read

